{
  "suite": "harness-agent-binding",
  "schema_version": 1,
  "corpus_version": "0.1.0",
  "generated_by": "Hand-written expectations (G-321 E). Every language's runner drives its real runtime and asserts it against `expected`.",
  "pins_note": "Which provider and model a run, and a subagent's child run, actually request; and which delegations are refused before any request.",
  "fake": {
    "parent_first_step": "calls the `run.delegate` subagent tool with task `t` when set, else answers",
    "child": "answers",
    "parent_second_step": "answers",
    "record": "provider and model of the FIRST parent request and the FIRST child request; `refused: config` when the run is refused before any provider request"
  },
  "cases": [
    {
      "id": "hab-0001",
      "title": "agent default applies when the mode names nothing",
      "global": {
        "provider": "anthropic",
        "model": "global-model"
      },
      "modes": {},
      "agents": {
        "planner": {
          "model": "agent-model",
          "modes": {
            "plan": {}
          }
        }
      },
      "run": {
        "agent": "planner",
        "mode": "plan",
        "session_provider": null,
        "session_model": null,
        "delegate": null
      },
      "expected": {
        "refused": null,
        "parent": {
          "provider": "anthropic",
          "model": "agent-model"
        },
        "child": null
      },
      "notes": "Baseline: agent > global."
    },
