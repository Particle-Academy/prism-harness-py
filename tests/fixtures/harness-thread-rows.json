      "rows": {
        "php": "[{\"type\":\"tool_result\",\"tool_results\":[{\"tool_call_id\":\"call_1\",\"tool_name\":\"search\",\"args\":{\"query\":\"tigers\"},\"result\":\"The game is at 3pm.\",\"tool_call_result_id\":\"call_1\",\"artifacts\":[]},{\"tool_call_id\":\"call_2\",\"tool_name\":\"weather\",\"args\":{},\"result\":\"{\\\"temp\\\": 75}\",\"tool_call_result_id\":null,\"artifacts\":[]}],\"tool_approval_responses\":[]}]",
        "ts": "[{\"type\":\"tool_result\",\"tool_results\":[{\"tool_call_id\":\"call_1\",\"tool_name\":\"search\",\"args\":{\"query\":\"tigers\"},\"result\":\"The game is at 3pm.\",\"tool_call_result_id\":\"call_1\",\"artifacts\":[]},{\"tool_call_id\":\"call_2\",\"tool_name\":\"weather\",\"args\":{},\"result\":\"{\\\"temp\\\": 75}\",\"tool_call_result_id\":null,\"artifacts\":[]}],\"tool_approval_responses\":[]}]",
        "py": "[{\"type\":\"tool_result\",\"tool_results\":[{\"tool_call_id\":\"call_1\",\"tool_name\":\"search\",\"args\":{\"query\":\"tigers\"},\"result\":\"The game is at 3pm.\",\"tool_call_result_id\":\"call_1\",\"artifacts\":[]},{\"tool_call_id\":\"call_2\",\"tool_name\":\"weather\",\"args\":{},\"result\":\"{\\\"temp\\\": 75}\",\"tool_call_result_id\":null,\"artifacts\":[]}],\"tool_approval_responses\":[]}]"
      },
      "agrees": true,
      "notes": "One row per step, as the reference stores it, with each result keyed by its call. A result that looks like JSON stays a string and must not be decoded into structure. The empty-arguments boundary again, on `args`."
