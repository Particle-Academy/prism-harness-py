    {
      "id": "thr-0004",
      "title": "two calls waiting on approval, one approval request each",
      "since": "0.1.0",
      "input": {
        "write": "assistant",
        "content": "",
        "tool_calls": [
          {
            "id": "call_1",
            "name": "delete_file",
            "arguments": {
              "path": "/tmp/a"
            }
          },
          {
            "id": "call_2",
            "name": "delete_file",
            "arguments": {
              "path": "/tmp/b"
            }
          }
        ],
        "additional_content": {},
        "approval_requests": [
          {
            "approval_id": "apr_1",
            "tool_call_id": "call_1"
          },
          {
            "approval_id": "apr_2",
            "tool_call_id": "call_2"
          }
        ]
      },
      "rows": {
        "php": "[{\"type\":\"assistant\",\"content\":\"\",\"tool_calls\":[{\"id\":\"call_1\",\"name\":\"delete_file\",\"arguments\":{\"path\":\"/tmp/a\"},\"result_id\":null,\"reasoning_id\":null,\"reasoning_summary\":null},{\"id\":\"call_2\",\"name\":\"delete_file\",\"arguments\":{\"path\":\"/tmp/b\"},\"result_id\":null,\"reasoning_id\":null,\"reasoning_summary\":null}],\"additional_content\":{},\"tool_approval_requests\":[{\"approval_id\":\"apr_1\",\"tool_call_id\":\"call_1\"},{\"approval_id\":\"apr_2\",\"tool_call_id\":\"call_2\"}]}]",
        "ts": "[{\"type\":\"assistant\",\"content\":\"\",\"tool_calls\":[{\"id\":\"call_1\",\"name\":\"delete_file\",\"arguments\":{\"path\":\"/tmp/a\"},\"result_id\":null,\"reasoning_id\":null,\"reasoning_summary\":null},{\"id\":\"call_2\",\"name\":\"delete_file\",\"arguments\":{\"path\":\"/tmp/b\"},\"result_id\":null,\"reasoning_id\":null,\"reasoning_summary\":null}],\"additional_content\":{},\"tool_approval_requests\":[{\"approval_id\":\"apr_1\",\"tool_call_id\":\"call_1\"},{\"approval_id\":\"apr_2\",\"tool_call_id\":\"call_2\"}]}]",
        "py": "[{\"type\":\"assistant\",\"content\":\"\",\"tool_calls\":[{\"id\":\"call_1\",\"name\":\"delete_file\",\"arguments\":{\"path\":\"/tmp/a\"},\"result_id\":null,\"reasoning_id\":null,\"reasoning_summary\":null},{\"id\":\"call_2\",\"name\":\"delete_file\",\"arguments\":{\"path\":\"/tmp/b\"},\"result_id\":null,\"reasoning_id\":null,\"reasoning_summary\":null}],\"additional_content\":{},\"tool_approval_requests\":[{\"approval_id\":\"apr_1\",\"tool_call_id\":\"call_1\"},{\"approval_id\":\"apr_2\",\"tool_call_id\":\"call_2\"}]}]"
      },
      "agrees": true,
      "notes": "G-59. The approval requests ride on the assistant row, each naming the call it authorises. A language that stored them elsewhere, or keyed them differently, would resume a PHP-recorded approval against the wrong call or never, and an approved call must never run as the wrong one."
    },
    {
      "id": "thr-0005",
      "title": "arguments a hostile model chose",
      "since": "0.1.0",
      "input": {
        "write": "assistant",
        "content": "",
        "tool_calls": [
          {
            "id": "call_1",
            "name": "search",
            "arguments": {
              "query": "'; DROP TABLE users; --",
              "__proto__": "polluted",
              "nested.key": {
                "naïve": [
                  "ü",
                  "日本",
                  ""
                ],
                "path": "../../etc/passwd"
              }
            }
          }
        ],
        "additional_content": {},
        "approval_requests": []
      },
      "rows": {
        "php": "[{\"type\":\"assistant\",\"content\":\"\",\"tool_calls\":[{\"id\":\"call_1\",\"name\":\"search\",\"arguments\":{\"query\":\"'; DROP TABLE users; --\",\"__proto__\":\"polluted\",\"nested.key\":{\"naïve\":[\"ü\",\"日本\",\"\"],\"path\":\"../../etc/passwd\"}},\"result_id\":null,\"reasoning_id\":null,\"reasoning_summary\":null}],\"additional_content\":{},\"tool_approval_requests\":[]}]",
        "ts": "[{\"type\":\"assistant\",\"content\":\"\",\"tool_calls\":[{\"id\":\"call_1\",\"name\":\"search\",\"arguments\":{\"query\":\"'; DROP TABLE users; --\",\"__proto__\":\"polluted\",\"nested.key\":{\"naïve\":[\"ü\",\"日本\",\"\"],\"path\":\"../../etc/passwd\"}},\"result_id\":null,\"reasoning_id\":null,\"reasoning_summary\":null}],\"additional_content\":{},\"tool_approval_requests\":[]}]",
        "py": "[{\"type\":\"assistant\",\"content\":\"\",\"tool_calls\":[{\"id\":\"call_1\",\"name\":\"search\",\"arguments\":{\"query\":\"'; DROP TABLE users; --\",\"__proto__\":\"polluted\",\"nested.key\":{\"naïve\":[\"ü\",\"日本\",\"\"],\"path\":\"../../etc/passwd\"}},\"result_id\":null,\"reasoning_id\":null,\"reasoning_summary\":null}],\"additional_content\":{},\"tool_approval_requests\":[]}]"
      },
      "agrees": true,
      "notes": "Adversarial arguments stored as data, never interpreted: an injection string, a `__proto__` key that must stay an ordinary key, a dotted key that must not become a path, non-ASCII text, an empty string, and a traversal-shaped path. All three languages must store exactly what the model sent."
    },
