    {
      "id": "thr-0007",
      "title": "decisions only: an approval, a denial with a reason, a denial without one",
      "since": "0.1.0",
      "input": {
        "write": "tool_result",
        "results": [],
        "decisions": [
          {
            "approval_id": "apr_1",
            "approved": true,
            "reason": null
          },
          {
            "approval_id": "apr_2",
            "approved": false,
            "reason": "not on production"
          },
          {
            "approval_id": "apr_3",
            "approved": false,
            "reason": null
          }
        ]
      },
      "rows": {
        "php": "[{\"type\":\"tool_result\",\"tool_results\":[],\"tool_approval_responses\":[{\"approval_id\":\"apr_1\",\"approved\":true,\"reason\":null},{\"approval_id\":\"apr_2\",\"approved\":false,\"reason\":\"not on production\"},{\"approval_id\":\"apr_3\",\"approved\":false,\"reason\":null}]}]",
        "ts": "[{\"type\":\"tool_result\",\"tool_results\":[],\"tool_approval_responses\":[{\"approval_id\":\"apr_1\",\"approved\":true,\"reason\":null},{\"approval_id\":\"apr_2\",\"approved\":false,\"reason\":\"not on production\"},{\"approval_id\":\"apr_3\",\"approved\":false,\"reason\":null}]}]",
        "py": "[{\"type\":\"tool_result\",\"tool_results\":[],\"tool_approval_responses\":[{\"approval_id\":\"apr_1\",\"approved\":true,\"reason\":null},{\"approval_id\":\"apr_2\",\"approved\":false,\"reason\":\"not on production\"},{\"approval_id\":\"apr_3\",\"approved\":false,\"reason\":null}]}]"
      },
      "agrees": true,
      "notes": "What recording a decision writes. A denial must stay a denial across languages: an `approved` that became truthy, or a missing reason that became an empty string, changes what the resumed run does. Refused calls never run."
    },
