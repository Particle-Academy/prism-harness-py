{
  "suite": "harness-thread-rows",
  "schema_version": 1,
  "corpus_version": "0.1.0",
  "generated_by": "prism-parity:tools/generate-thread-rows.php for php; tools/record-thread-rows.mjs for ts and tools/record_thread_rows.py for py. Every output is execution output, encoded as compact JSON with keys in the order each language wrote them.",
  "pins_note": "The rows a harness stores for a run, and what a stored run is replayed as. A PHP app and a TypeScript or Python agent can share one session. If they store tool calls, approvals or decisions in different shapes, one language resumes the other’s approval against the wrong call or never, or replays a conversation a provider refuses.",
  "cases": [
    {
      "id": "thr-0001",
      "title": "a reply with no tool calls and no provider state",
      "since": "0.1.0",
      "input": {
        "write": "assistant",
        "content": "Hello.",
        "tool_calls": [],
        "additional_content": {},
        "approval_requests": []
      },
      "rows": {
        "php": "[{\"type\":\"assistant\",\"content\":\"Hello.\",\"tool_calls\":[],\"additional_content\":{},\"tool_approval_requests\":[]}]",
        "ts": "[{\"type\":\"assistant\",\"content\":\"Hello.\",\"tool_calls\":[],\"additional_content\":{},\"tool_approval_requests\":[]}]",
        "py": "[{\"type\":\"assistant\",\"content\":\"Hello.\",\"tool_calls\":[],\"additional_content\":{},\"tool_approval_requests\":[]}]"
      },
      "agrees": true,
      "notes": "The control, and the empty-map boundary. A reply with no provider state must store an EMPTY MAP, not an empty list: a reader in a typed language that expects an object refuses a list, and PHP writes an empty array as a list unless told otherwise."
    },
    {
      "id": "thr-0002",
      "title": "a tool call with its arguments, provider ids and provider state",
      "since": "0.1.0",
      "input": {
        "write": "assistant",
        "content": "Checking.",
        "tool_calls": [
          {
            "id": "fc_1",
            "name": "weather",
            "arguments": {
              "city": "Detroit"
            },
            "result_id": "call_1",
            "reasoning_id": "rs_1",
            "reasoning_summary": [
              {
                "type": "summary_text",
                "text": "Look it up."
              }
            ]
          }
        ],
        "additional_content": {
          "thinking": "The user wants the weather.",
          "thinking_signature": "sig-1"
        },
        "approval_requests": []
      },
      "rows": {
        "php": "[{\"type\":\"assistant\",\"content\":\"Checking.\",\"tool_calls\":[{\"id\":\"fc_1\",\"name\":\"weather\",\"arguments\":{\"city\":\"Detroit\"},\"result_id\":\"call_1\",\"reasoning_id\":\"rs_1\",\"reasoning_summary\":[{\"type\":\"summary_text\",\"text\":\"Look it up.\"}]}],\"additional_content\":{\"thinking\":\"The user wants the weather.\",\"thinking_signature\":\"sig-1\"},\"tool_approval_requests\":[]}]",
        "ts": "[{\"type\":\"assistant\",\"content\":\"Checking.\",\"tool_calls\":[{\"id\":\"fc_1\",\"name\":\"weather\",\"arguments\":{\"city\":\"Detroit\"},\"result_id\":\"call_1\",\"reasoning_id\":\"rs_1\",\"reasoning_summary\":[{\"type\":\"summary_text\",\"text\":\"Look it up.\"}]}],\"additional_content\":{\"thinking\":\"The user wants the weather.\",\"thinking_signature\":\"sig-1\"},\"tool_approval_requests\":[]}]",
        "py": "[{\"type\":\"assistant\",\"content\":\"Checking.\",\"tool_calls\":[{\"id\":\"fc_1\",\"name\":\"weather\",\"arguments\":{\"city\":\"Detroit\"},\"result_id\":\"call_1\",\"reasoning_id\":\"rs_1\",\"reasoning_summary\":[{\"type\":\"summary_text\",\"text\":\"Look it up.\"}]}],\"additional_content\":{\"thinking\":\"The user wants the weather.\",\"thinking_signature\":\"sig-1\"},\"tool_approval_requests\":[]}]"
      },
      "agrees": true,
      "notes": "G-58. Everything the next request has to send back: the call's arguments (a tool_use without input is refused), OpenAI's call and reasoning ids, and Anthropic's thinking signature. The ports used to store an id and a name only."
    },
    {
      "id": "thr-0003",
      "title": "a tool call with NO arguments",
      "since": "0.1.0",
      "input": {
        "write": "assistant",
        "content": "",
        "tool_calls": [
          {
            "id": "call_1",
            "name": "now",
            "arguments": {}
          }
        ],
        "additional_content": {},
        "approval_requests": []
      },
      "rows": {
        "php": "[{\"type\":\"assistant\",\"content\":\"\",\"tool_calls\":[{\"id\":\"call_1\",\"name\":\"now\",\"arguments\":{},\"result_id\":null,\"reasoning_id\":null,\"reasoning_summary\":null}],\"additional_content\":{},\"tool_approval_requests\":[]}]",
        "ts": "[{\"type\":\"assistant\",\"content\":\"\",\"tool_calls\":[{\"id\":\"call_1\",\"name\":\"now\",\"arguments\":{},\"result_id\":null,\"reasoning_id\":null,\"reasoning_summary\":null}],\"additional_content\":{},\"tool_approval_requests\":[]}]",
        "py": "[{\"type\":\"assistant\",\"content\":\"\",\"tool_calls\":[{\"id\":\"call_1\",\"name\":\"now\",\"arguments\":{},\"result_id\":null,\"reasoning_id\":null,\"reasoning_summary\":null}],\"additional_content\":{},\"tool_approval_requests\":[]}]"
      },
      "agrees": true,
      "notes": "The empty-arguments boundary. `arguments` must be an empty map. Stored as an empty list, it is replayed to a provider as an array where an object is required, and the request is refused."
